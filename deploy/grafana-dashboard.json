{
  "title": "SolarSense service health",
  "uid": "solar-health",
  "schemaVersion": 40,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Accepted readings / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "solar-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "rate(solar_accepted_total[1m])",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Processing p95 seconds",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "solar-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(solar_processing_seconds_bucket[1m])) by (le))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Pending telemetry",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "solar-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "solar_pending",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Active viewers",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "solar-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "solar_viewers",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Rejected requests / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "solar-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "rate(solar_rejected_total[1m])",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Failed notifications",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "solar-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "solar_notification_failures",
          "refId": "A"
        }
      ]
    }
  ]
}
